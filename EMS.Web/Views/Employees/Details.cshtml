@model EMS.Web.Models.ViewModels.EmployeeViewModel
@using EMS.Web.Models

@{
    ViewData["Title"] = "Employee Details";
}

<div class="card" style="max-width: 700px;">
    <div class="card-body p-4">
        <div class="d-flex align-items-center gap-3 mb-4">
            @if (!string.IsNullOrEmpty(Model.ExistingPhotoPath))
            {
                <img src="@Model.ExistingPhotoPath" width="80" height="80" class="rounded-circle" style="object-fit:cover;" />
            }
            else
            {
                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width:80px;height:80px;font-size:1.5rem;">
                    @Model.FirstName[0]@Model.LastName[0]
                </div>
            }
            <div>
                <h4 class="mb-1">@Model.FullName</h4>
                @{
                    var badgeClass = Model.Status switch
                    {
                        EmployeeStatus.Active => "badge-active",
                        EmployeeStatus.OnLeave => "badge-leave",
                        _ => "badge-terminated"
                    };
                }
                <span class="badge @badgeClass">@Model.Status</span>
            </div>
        </div>

        <dl class="row">
            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Phone</dt>
            <dd class="col-sm-8">@(Model.Phone ?? "—")</dd>

            <dt class="col-sm-4">Date of Birth</dt>
            <dd class="col-sm-8">@(Model.DateOfBirth?.ToString("dd MMM yyyy") ?? "—")</dd>

            <dt class="col-sm-4">Address</dt>
            <dd class="col-sm-8">@(Model.Address ?? "—")</dd>

            <dt class="col-sm-4">Department</dt>
            <dd class="col-sm-8">@Model.DepartmentName</dd>

            <dt class="col-sm-4">Designation</dt>
            <dd class="col-sm-8">@Model.DesignationName</dd>

            <dt class="col-sm-4">Salary</dt>
            <dd class="col-sm-8">@Model.Salary.ToString("N0")</dd>

            <dt class="col-sm-4">Joining Date</dt>
            <dd class="col-sm-8">@Model.JoiningDate.ToString("dd MMM yyyy")</dd>
        </dl>

        <div class="d-flex gap-2 mt-3">
            @if (User.IsInRole("Admin") || User.IsInRole("HR"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>
</div>