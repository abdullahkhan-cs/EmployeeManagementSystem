@model List<EMS.Web.Models.ViewModels.EmployeeViewModel>
@using EMS.Web.Models

@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <form method="get" class="d-flex gap-2">
        <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search name or email..." style="width: 240px;" />

        <select name="departmentId" class="form-select" style="width: 180px;" asp-items="ViewBag.Departments">
            <option value="">All Departments</option>
        </select>

        <select name="status" class="form-select" style="width: 160px;">
            <option value="">All Status</option>
            @foreach (var s in Enum.GetValues<EmployeeStatus>())
            {
                <option value="@s" selected="@(ViewBag.SelectedStatus?.ToString() == s.ToString())">@s</option>
            }
        </select>

        <button type="submit" class="btn btn-outline-primary">
            <i class="bi bi-search"></i>
        </button>
    </form>

    <div class="d-flex gap-2">
        <a asp-action="ExportExcel"
           asp-route-search="@ViewBag.SearchTerm"
           asp-route-departmentId="@Context.Request.Query["departmentId"]"
           asp-route-status="@ViewBag.SelectedStatus"
           class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Excel
        </a>
        <a asp-action="ExportPdf"
           asp-route-search="@ViewBag.SearchTerm"
           asp-route-departmentId="@Context.Request.Query["departmentId"]"
           asp-route-status="@ViewBag.SelectedStatus"
           class="btn btn-outline-danger">
            <i class="bi bi-file-earmark-pdf me-1"></i> PDF
        </a>

        @if (User.IsInRole("Admin") || User.IsInRole("HR"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Add Employee
            </a>
        }
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th class="ps-3">Employee</th>
                    <th>Department</th>
                    <th>Designation</th>
                    <th>Joined</th>
                    <th>Status</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No employees found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(emp.ExistingPhotoPath))
                                    {
                                        <img src="@emp.ExistingPhotoPath" class="rounded-circle" width="36" height="36" style="object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width:36px;height:36px;font-size:0.85rem;">
                                            @emp.FirstName[0]@emp.LastName[0]
                                        </div>
                                    }
                                    <div>
                                        <div class="fw-semibold">@emp.FullName</div>
                                        <div class="text-muted small">@emp.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>@emp.DepartmentName</td>
                            <td>@emp.DesignationName</td>
                            <td>@emp.JoiningDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @{
                                    var badgeClass = emp.Status switch
                                    {
                                        EmployeeStatus.Active => "badge-active",
                                        EmployeeStatus.OnLeave => "badge-leave",
                                        _ => "badge-terminated"
                                    };
                                }
                                <span class="badge @badgeClass">@emp.Status</span>
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="Details" asp-route-id="@emp.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                                {
                                    <a asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@emp.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>