@model EMS.Web.Models.ViewModels.DesignationViewModel

@{
    ViewData["Title"] = "Delete Designation";
}

<div class="card" style="max-width: 500px;">
    <div class="card-body p-4">
        <p>Are you sure you want to delete this designation?</p>

        <dl class="row mb-0">
            <dt class="col-sm-4">Title</dt>
            <dd class="col-sm-8">@Model.Title</dd>

            <dt class="col-sm-4">Department</dt>
            <dd class="col-sm-8">@Model.DepartmentName</dd>

            <dt class="col-sm-4">Employees</dt>
            <dd class="col-sm-8">@Model.EmployeeCount</dd>
        </dl>

        @if (Model.EmployeeCount > 0)
        {
            <div class="alert alert-warning mt-3 mb-0">
                This designation has employees assigned. Deletion will be blocked until they're reassigned.
            </div>
        }

        <form asp-action="Delete" method="post" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash me-1"></i> Delete
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>