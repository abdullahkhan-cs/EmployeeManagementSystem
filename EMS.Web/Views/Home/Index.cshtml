@model EMS.Web.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted small">Total Employees</div>
            <div class="fs-3 fw-bold">@Model.TotalEmployees</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted small">Departments</div>
            <div class="fs-3 fw-bold">@Model.TotalDepartments</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted small">Active</div>
            <div class="fs-3 fw-bold text-success">@Model.ActiveCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted small">On Leave / Terminated</div>
            <div class="fs-3 fw-bold text-warning">@Model.OnLeaveCount <span class="text-danger fs-6">/ @Model.TerminatedCount</span></div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-7">
        <div class="card p-3">
            <h6 class="mb-3">Headcount by Department</h6>
            <canvas id="deptChart" height="220"></canvas>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card p-3">
            <h6 class="mb-3">Recent Joiners</h6>
            @if (!Model.RecentJoiners.Any())
            {
                <p class="text-muted small mb-0">No employees yet.</p>
            }
            else
            {
                @foreach (var r in Model.RecentJoiners)
                {
                    <div class="d-flex align-items-center gap-2 mb-3">
                        @if (!string.IsNullOrEmpty(r.PhotoPath))
                        {
                            <img src="@r.PhotoPath" width="36" height="36" class="rounded-circle" style="object-fit:cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width:36px;height:36px;font-size:0.8rem;">
                                @r.FullName.Substring(0, 1)
                            </div>
                        }
                        <div class="flex-grow-1">
                            <div class="fw-semibold small">@r.FullName</div>
                            <div class="text-muted small">@r.DesignationName · @r.DepartmentName</div>
                        </div>
                        <div class="text-muted small">@r.JoiningDate.ToString("dd MMM")</div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const ctx = document.getElementById('deptChart');
        new Chart(ctx, {
        type: 'bar',
        data: {
        labels: @Html.Raw(Json.Serialize(Model.DepartmentLabels)),
        datasets: [{
        label: 'Employees',
        data: @Html.Raw(Json.Serialize(Model.DepartmentCounts)),
        backgroundColor: '#2f6fed',
        borderRadius: 6
        }]
        },
        options: {
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
        });
    </script>
}